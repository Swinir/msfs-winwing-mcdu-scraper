mcdu:
  captain:
    enabled: true
    # Window title substring used by the CLI to find the MSFS pop-out window.
    # Use a partial string; matching is case-insensitive.
    # Run the GUI once and look at the "Window Selection" dropdown to find the right title.
    # Example: "Microsoft Flight Simulator" or "MCDU"
    window_title: "Microsoft Flight Simulator"

    # Crop the captured window down to just the MCDU screen.
    # STRONGLY RECOMMENDED: without it the *whole window* is carved into the
    # 24x14 character grid, which only works if the window happens to be
    # exactly the MCDU display.
    # Coordinates are relative to the captured window's top-left corner.
    # Easiest way to find them: run the GUI, pick your window, click
    # "Select Screen Area" (or "Auto Detect"), and copy the reported values.
    # crop:
    #   x: 0
    #   y: 0
    #   width: 480
    #   height: 280

  copilot:
    enabled: false
    # window_title: "Microsoft Flight Simulator"
    # crop:
    #   x: 0
    #   y: 0
    #   width: 480
    #   height: 280

mobiflight:
  captain_url: "ws://localhost:8320/winwing/cdu-captain"
  copilot_url: "ws://localhost:8320/winwing/cdu-co-pilot"
  font: "AirbusThales"
  max_retries: 3

performance:
  capture_fps: 30
  # Reuse the previous parse when a frame is nearly identical to the last
  # one.  Big CPU saving on a static MCDU page; turn off only when debugging.
  enable_caching: true

# OCR settings (optional — sensible defaults are used if omitted)
# ocr:
#   # Template matching threshold (0.0–1.0).  Lower = more permissive.
#   template_threshold: 0.78
#   # EasyOCR confidence floor.  Detections below this are discarded.
#   easyocr_min_confidence: 0.15
