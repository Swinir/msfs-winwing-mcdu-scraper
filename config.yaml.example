mcdu:
  captain:
    enabled: true
    # Window title substring used by the CLI to find the MSFS pop-out window.
    # Use a partial string; matching is case-insensitive.
    # Run the GUI once and look at the "Window Selection" dropdown to find the right title.
    # Example: "Microsoft Flight Simulator" or "MCDU"
    window_title: "Microsoft Flight Simulator"

  copilot:
    enabled: false
    # window_title: "Microsoft Flight Simulator"

mobiflight:
  captain_url: "ws://localhost:8320/winwing/cdu-captain"
  copilot_url: "ws://localhost:8320/winwing/cdu-co-pilot"
  font: "AirbusThales"
  max_retries: 3

performance:
  capture_fps: 30
  enable_caching: true

# OCR settings (optional — sensible defaults are used if omitted)
# ocr:
#   # Template matching threshold (0.0–1.0).  Lower = more permissive.
#   template_threshold: 0.78
#   # EasyOCR confidence floor.  Detections below this are discarded.
#   easyocr_min_confidence: 0.15
